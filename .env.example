# Supabase Configuration (Copy this to .env and replace with your actual values!)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Supabase Edge Function Secrets (Set via: supabase secrets set FIREBASE_SERVICE_ACCOUNT='...')
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
