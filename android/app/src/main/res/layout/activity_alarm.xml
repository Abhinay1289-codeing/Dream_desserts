<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="16dp">

    <!-- Top Header Bar: Logo & Cafe Title -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:src="@drawable/cafe_logo"
            android:scaleType="centerCrop"
            android:background="@android:color/transparent"
            android:elevation="6dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KITCHEN ORDERS"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 NEW INCOMING ORDER"
                android:textColor="#FF6B6B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvTableBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Table #—"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_table"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"/>
    </LinearLayout>

    <!-- Bottom Buttons Container -->
    <LinearLayout
        android:id="@+id/buttonsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center">

        <!-- Accept Button -->
        <Button
            android:id="@+id/btnAccept"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/btn_accept"
            android:text="✅ ACCEPT ORDER — PREPARE"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:stateListAnimator="@null"
            android:elevation="8dp"
            android:layout_marginBottom="10dp"/>

        <!-- Cancel Button -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/btn_cancel"
            android:text="DECLINE / DISMISS"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:elevation="4dp"/>
    </LinearLayout>

    <!-- Center Scrollable Receipt Card -->
    <ScrollView
        android:id="@+id/receiptScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerLayout"
        android:layout_above="@id/buttonsLayout"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_receipt"
            android:padding="16dp">

            <!-- Receipt Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tvReceiptTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧾 ORDER BILL RECEIPT"
                    android:textColor="#FDE047"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_alignParentStart="true"/>

                <TextView
                    android:id="@+id/tvOrderTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Just Now"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

            <!-- Customer Details Line -->
            <TextView
                android:id="@+id/tvCustomerDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Customer: Guest"
                android:textColor="#D1D5DB"
                android:textSize="13sp"
                android:paddingBottom="8dp"/>

            <!-- Item Table Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#222738"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.2"
                    android:text="ITEM"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:text="QTY"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:text="RATE"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="end"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="AMOUNT"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="end"/>
            </LinearLayout>

            <!-- Dynamic Items Container -->
            <LinearLayout
                android:id="@+id/itemsListLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="4dp">
                <!-- Dynamically populated rows in AlarmActivity.java -->
            </LinearLayout>

            <!-- Dashed Divider -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:src="@drawable/divider_line"
                android:scaleType="fitXY"
                android:layerType="software"
                android:layout_marginVertical="10dp"/>

            <!-- Financial Breakdown -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Subtotal Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subtotal"
                        android:textColor="#9CA3AF"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tvSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0"
                        android:textColor="#D1D5DB"
                        android:textSize="13sp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>

                <!-- GST Row -->
                <RelativeLayout
                    android:id="@+id/rowGst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GST / Tax"
                        android:textColor="#9CA3AF"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tvGst"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0"
                        android:textColor="#D1D5DB"
                        android:textSize="13sp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>

                <!-- Grand Total Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingTop="6dp"
                    android:background="#1E2333"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GRAND TOTAL"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_centerVertical="true"/>

                    <TextView
                        android:id="@+id/tvGrandTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0"
                        android:textColor="#4ADE80"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </LinearLayout>

            <!-- Order Notes Box -->
            <LinearLayout
                android:id="@+id/notesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#292115"
                android:padding="10dp"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 Special Instructions / Notes:"
                    android:textColor="#FBBF24"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvOrderNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FEF3C7"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
